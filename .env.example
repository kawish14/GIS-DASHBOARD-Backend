# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# Server
PORT=2000

# Google Gemini API Key (routes/gemini.js)
GEMINI_API_KEY=

# --- Invitation email -------------------------------------------------------
# Where the dashboard is served. The invitation email links to <this>/register.
APP_BASE_URL=http://172.29.100.28:5173

# SMTP. Leave SMTP_HOST blank to turn invitation emails off: invites still
# work, and the admin panel shows the registration link to pass on by hand.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; false for 587, which upgrades via STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The From: header on outgoing mail
MAIL_FROM="TES GIS Dashboard <no-reply@tes.com.pk>"

# --- User activity log (user_logs table) -------------------------------------
# Rows older than this many days are deleted once a day. 0 keeps them forever.
USER_LOG_RETENTION_DAYS=365
